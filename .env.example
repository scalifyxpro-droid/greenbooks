# Green Books - Email Configuration

# Recipient (Where the leads/messages are delivered)
CONTACT_RECEIVER_EMAIL=Info@greenbooks.ae

# -------------------------------------------------------------
# OPTION 1: Using Your Personal Gmail
# -------------------------------------------------------------
# 1. Turn on 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in:
SMTP_USER=yourpersonalemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# -------------------------------------------------------------
# OPTION 2: Using cPanel Webmail
# -------------------------------------------------------------
# SMTP_HOST=mail.greenbooks.ae
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=Info@greenbooks.ae
# SMTP_PASS=your_cpanel_password
